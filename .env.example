# Generate secrets using: openssl rand -hex 32
# Use hex for the database password so it is safe inside the connection URL.
POSTGRES_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
APP_SECRET=
# Optional independent Meta encryption keyring: JSON values are base64 32-byte keys.
# Keep old keys during rewrap. See docs/meta-setup.md. Empty preserves APP_SECRET encryption.
META_ENCRYPTION_KEYS=
META_ENCRYPTION_KEY_ID=
# TikTok stays off until one test Pixel completes Events Manager validation.
TIKTOK_ENABLED=false
TIKTOK_EVENTS_URL=https://business-api.tiktok.com/open_api/v1.3/event/track/
PUBLIC_BASE_URL=http://localhost:8080
REPORT_TIMEZONE=Asia/Shanghai
RETENTION_DAYS=90
# all = anonymous visitor cookies for independent visitor metrics; this is not a login Cookie.
# Confirm the collection policy remains appropriate for every target market before deployment.
COOKIE_MODE=all
# Explicitly list reverse proxy IP/CIDR only; never trust the entire Internet.
TRUSTED_PROXIES=
# Download your licensed GeoLite2 City / compatible City mmdb into ./geoip then set:
# GEOIP_DB_PATH=/app/geoip/GeoLite2-City.mmdb
GEOIP_DB_PATH=/app/geoip/dbip-city-lite-2026-09.mmdb
# 可选：本地运行时覆盖语音小说前端构建目录；容器内固定为 /app/audio-novel。
# AUDIO_NOVEL_DIR=../audio-novel/dist
# 可选：本地运行时语音小说封面目录；Docker 使用持久卷中的固定路径。
# AUDIO_NOVEL_UPLOAD_DIR=../data/audio-novel-uploads
# 可选：本地运行时语音小说 MP3 目录；与封面和免费小说文件完全分开。
# AUDIO_NOVEL_AUDIO_DIR=../data/audio-novel-audio
# 可选：本地运行时覆盖免费小说 H5 构建目录；容器内固定为 /app/novel-h5。
# NOVEL_DIR=../novel-h5/dist
# 可选：本地运行时免费小说封面目录；与语音小说封面完全分开。
# NOVEL_UPLOAD_DIR=../data/novel-uploads
# 接口盒子翻译凭证只配置在后端环境，不要写入任何 VITE_ 前端变量。
APIHZ_TRANSLATION_ID=
APIHZ_TRANSLATION_KEY=
APIHZ_TRANSLATION_URL=https://cn.apihz.cn/api/zici/fanyiapihz.php
# 越南语改由 DeepL Free API 生成；密钥只保存在服务器 .env。
DEEPL_AUTH_KEY=
DEEPL_TRANSLATION_URL=https://api-free.deepl.com/v2/translate
